# =============================================================================
# Invoice Desk — Environment Configuration
# =============================================================================

# Server Port
PORT=3001
NODE_ENV=development

# Storage (SQLite Single Source of Truth)
DATABASE_PATH=./data/invoicedesk.db

# -----------------------------------------------------------------------------
# 1. Fastn Connector Integration (Server-Side Only)
# -----------------------------------------------------------------------------
# Obtain your workspace API key at https://app.fastn.ai
FASTN_API_KEY=your_fastn_api_key_here

FASTN_BASE_URL=https://api.fastn.ai
FASTN_MCP_URL=https://mcp.fastn.dev/fastn-workspace

# -----------------------------------------------------------------------------
# 2. AI Model A: Google Gemini (Google AI Studio)
# -----------------------------------------------------------------------------
# Obtain your API key at https://aistudio.google.com
GEMINI_API_KEY=gemini_key_here
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------------
# 3. AI Model B: OpenRouter (Multi-Model Risk Auditor)
# -----------------------------------------------------------------------------
# Obtain your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# -----------------------------------------------------------------------------
# Legacy / Secondary Fallbacks (Optional)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NOTE: If AI keys or FASTN_API_KEY are not configured, Invoice Desk runs
# seamlessly in Local Demo Mode with full deterministic fraud verification,
# clearly tagged test extraction, and realistic demo scenarios.
# Keys are strictly kept server-side and never exposed to the frontend.
